#include <Arduino.h>
#include <LiquidCrystal.h>
#include <DHT.h>
#include "teslax_config.h"
LiquidCrystal lcd(LCD_RS,LCD_EN,LCD_D4,LCD_D5,LCD_D6,LCD_D7); DHT dht(PIN_DHT,DHT22);
enum Scenario{NORMAL,END_A_FAULT,END_B_FAULT,OVER_TEMP,OVER_CURRENT,LOW_BUS,HIGH_BUS,RX_LOSS,COIL_FAULT,OBSTACLE}; Scenario scenario=NORMAL;
bool faultA=false,faultB=false;String shutdownReason="NONE";float distanceCm,temp,hum,alignment=80,tx=80,received,efficiency,coilATemp,coilBTemp,currentA,currentB,busA,busB;unsigned long tick=0;
const char* scenName(){static const char*n[]={"NORMAL","END_A_FAULT","END_B_FAULT","OVER_TEMP","OVER_CURRENT","LOW_BUS","HIGH_BUS","RX_LOSS","COIL_FAULT","OBSTACLE"};return n[scenario];}
void safeOff(){digitalWrite(PIN_RELAY_A,LOW);digitalWrite(PIN_RELAY_B,LOW);digitalWrite(PIN_COIL_A,LOW);digitalWrite(PIN_COIL_B,LOW);}
void help(){Serial.println("TEST NORMAL|END_A_FAULT|END_B_FAULT|OVER_TEMP|OVER_CURRENT|LOW_BUS|HIGH_BUS|RX_LOSS|COIL_FAULT|OBSTACLE; STATUS; CLEAR; HELP");}
void command(){if(!Serial.available())return;String s=Serial.readStringUntil('\n');s.trim();s.toUpperCase();if(s=="CLEAR"){scenario=NORMAL;return;}if(s=="STATUS"){Serial.print("TEST ");Serial.println(scenName());return;}if(!s.startsWith("TEST ")){if(s=="HELP")help();return;}String x=s.substring(5);const String names[]={"NORMAL","END_A_FAULT","END_B_FAULT","OVER_TEMP","OVER_CURRENT","LOW_BUS","HIGH_BUS","RX_LOSS","COIL_FAULT","OBSTACLE"};for(byte i=0;i<10;i++)if(x==names[i])scenario=(Scenario)i;}
void setup(){pinMode(PIN_TRIG,OUTPUT);pinMode(PIN_ECHO,INPUT);pinMode(PIN_IR,INPUT);pinMode(PIN_CORE_FAULT_A,INPUT);pinMode(PIN_CORE_FAULT_B,INPUT);pinMode(PIN_BUZZER,OUTPUT);const uint8_t outputs[]={PIN_RELAY_A,PIN_RELAY_B,PIN_COIL_A,PIN_COIL_B,PIN_RECT_A,PIN_RECT_B,PIN_STATUS,PIN_FAULT_A,PIN_FAULT_B,PIN_SYSTEM};for(uint8_t i=0;i<sizeof(outputs);i++)pinMode(outputs[i],OUTPUT);safeOff();dht.begin();lcd.begin(16,2);Serial.begin(115200);Serial1.begin(115200);Serial.println("TESLAX,BOOT,MEGA2560");help();}
void loop(){command();if(millis()-tick<1000)return;tick=millis();digitalWrite(PIN_TRIG,LOW);delayMicroseconds(2);digitalWrite(PIN_TRIG,HIGH);delayMicroseconds(10);digitalWrite(PIN_TRIG,LOW);unsigned long u=pulseIn(PIN_ECHO,HIGH,30000);distanceCm=REAL_SENSOR_MODE?(u?u*.0343f/2:999):analogRead(PIN_DISTANCE_MODEL)*300.0/1023.0;temp=dht.readTemperature();hum=dht.readHumidity();bool sensorFail=isnan(temp)||isnan(hum);busA=analogRead(PIN_BUS_A)*5.0/1023;busB=analogRead(PIN_BUS_B)*5.0/1023;currentA=analogRead(PIN_CURRENT_A)*5.0/1023;currentB=analogRead(PIN_CURRENT_B)*5.0/1023;int rx=analogRead(PIN_RX_STATUS);efficiency=constrain((alignment/100.0)*(1.0/(1.0+distanceCm/100.0)),0,1);received=constrain((tx/100.0)*efficiency,0,1);coilATemp=temp+currentA*8;coilBTemp=temp+currentB*8;faultA=sensorFail||distanceCm>180||busA<1.0||busA>4.8||currentA>2.3||coilATemp>70||digitalRead(PIN_CORE_FAULT_A);faultB=sensorFail||rx<20||busB<1.0||busB>4.8||currentB>2.3||coilBTemp>70||digitalRead(PIN_CORE_FAULT_B);shutdownReason=sensorFail?"SENSOR":(distanceCm>180?"DISTANCE":(busA<1.0||busB<1.0?"LOW_BUS":(busA>4.8||busB>4.8?"HIGH_BUS":(currentA>2.3||currentB>2.3?"OVER_CURRENT":(coilATemp>70||coilBTemp>70?"OVER_TEMP":(rx<20?"RX_LOSS":(digitalRead(PIN_CORE_FAULT_A)||digitalRead(PIN_CORE_FAULT_B)?"COIL_FAULT":"NONE")))))));if(scenario==END_A_FAULT||scenario==OVER_TEMP||scenario==LOW_BUS||scenario==HIGH_BUS||scenario==OVER_CURRENT||scenario==OBSTACLE)faultA=true;if(scenario==END_B_FAULT||scenario==RX_LOSS||scenario==COIL_FAULT)faultB=true;if(scenario==END_A_FAULT)shutdownReason="END_A";if(scenario==END_B_FAULT)shutdownReason="END_B";if(scenario==COIL_FAULT)shutdownReason="COIL_FAULT";if(scenario==OVER_TEMP)shutdownReason="OVER_TEMP";if(scenario==OVER_CURRENT)shutdownReason="OVER_CURRENT";if(scenario==LOW_BUS)shutdownReason="LOW_BUS";if(scenario==HIGH_BUS)shutdownReason="HIGH_BUS";if(scenario==RX_LOSS)shutdownReason="RX_LOSS";if(scenario==OBSTACLE)shutdownReason="DISTANCE";safeOff();digitalWrite(PIN_RECT_A,HIGH);digitalWrite(PIN_RECT_B,HIGH);if(!faultA){digitalWrite(PIN_RELAY_A,HIGH);digitalWrite(PIN_COIL_A,HIGH);}if(!faultB){digitalWrite(PIN_RELAY_B,HIGH);digitalWrite(PIN_COIL_B,HIGH);}digitalWrite(PIN_STATUS,!faultA&&!faultB);digitalWrite(PIN_FAULT_A,faultA);digitalWrite(PIN_FAULT_B,faultB);digitalWrite(PIN_SYSTEM,faultA||faultB);if(faultA||faultB){tone(PIN_BUZZER,1800,120);if(faultA)Serial.print("TESLAX,FAULT,END_A,");if(faultB)Serial.print("TESLAX,FAULT,END_B,");Serial.print("TESLAX,SHUTDOWN,");Serial.println(shutdownReason);}Serial.print("TESLAX { distance:");Serial.print(distanceCm,1);Serial.print(", alignment:");Serial.print(alignment);Serial.print(", temperature:");Serial.print(temp,1);Serial.print(", humidity:");Serial.print(hum,1);Serial.print(", moisture:");Serial.print(analogRead(PIN_MOISTURE));Serial.print(", light:");Serial.print(analogRead(PIN_LIGHT));Serial.print(", transmitLevel:");Serial.print(tx);Serial.print(", receivedLevel:");Serial.print(received,3);Serial.print(", efficiency:");Serial.print(efficiency,3);Serial.print(", busA:");Serial.print(busA,2);Serial.print(", busB:");Serial.print(busB,2);Serial.print(", currentA:");Serial.print(currentA,2);Serial.print(", currentB:");Serial.print(currentB,2);Serial.print(", coilATemp:");Serial.print(coilATemp,1);Serial.print(", coilBTemp:");Serial.print(coilBTemp,1);Serial.print(", endA:");Serial.print(!faultA);Serial.print(", endB:");Serial.print(!faultB);Serial.print(", faultA:");Serial.print(faultA);Serial.print(", faultB:");Serial.print(faultB);Serial.print(", shutdownReason:\"");Serial.print(shutdownReason);Serial.println("\" }");Serial1.print("TESLAX_GATEWAY ");Serial1.println(scenName());}

